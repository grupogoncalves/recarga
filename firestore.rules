rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signedIn() { return request.auth != null; }
   function isAdmin() { return signedIn() && request.auth.token.admin == true; }
   function own(uid) { return signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true; }
   // Apenas o servidor importa registros e calcula totais.
   match /spott_transactions/{id} { allow read, write: if false; }
   match /sync_meta/{id} { allow read: if isAdmin(); allow write: if false; }
   match /participantes/{uid} {
     allow get: if own(uid) || isAdmin();
     allow list: if false;
     allow create: if own(uid) && request.resource.data.keys().hasOnly(['name','email','joinedAt'])
       && request.resource.data.name is string && request.resource.data.name.size() >= 3
       && request.resource.data.name.size() <= 120
       && request.resource.data.email == request.auth.token.email.lower()
       && request.resource.data.joinedAt is string;
     allow update, delete: if false;
   }
   match /resultados/{uid}/meses/{month} {
     allow get: if own(uid) || isAdmin();
     allow list, create, update, delete: if false;
   }
   match /{document=**} { allow read, write: if false; }
 }
}
